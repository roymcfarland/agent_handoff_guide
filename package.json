{
  "name": "agent_handoff_guide",
  "version": "1.0.0",
  "description": "Source for the Worksmith Labs Agent Handoff Framework reference site (worksmithlabs.com): document schema, prompt library, and failure-mode guardrails for shipping software with AI coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "Roy McFarland (https://www.npmjs.com/~roymcfarland)",
  "repository": {
    "type": "git",
    "url": "https://github.com/roymcfarland/agent_handoff_guide.git"
  },
  "bugs": {
    "url": "https://github.com/roymcfarland/agent_handoff_guide/issues"
  },
  "homepage": "https://worksmithlabs.com",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir ../dist/ssr && tsx scripts/prerender.ts && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "generate:prompts": "tsx scripts/generate-prompts.ts",
    "vercel:deploy": "pnpm dlx vercel@latest deploy --yes",
    "vercel:deploy:prod": "pnpm dlx vercel@latest deploy --prod --yes"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "lucide-react": "^0.453.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "4.17.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.23",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.3.7"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "overrides": {
      "express>path-to-regexp": "0.1.13",
      "qs@6": ">=6.16.1 <7",
      "body-parser@1": ">=1.20.9 <2",
      "proxy-addr@2": ">=2.0.8 <3",
      "browserslist@4": ">=4.28.7 <5",
      "source-map-js@1": ">=1.2.2 <2",
      "postcss-selector-parser@6": ">=6.1.5 <7"
    }
  }
}
